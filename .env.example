# =============================================================================
# polymarket-backend 环境变量模板
# 用法：cp .env.example .env ，只填「必填」和你启用的功能相关项。
#
# 放哪里？
#   .env（服务器发布目录，chmod 600）
#     — 普通配置 + 多数密钥。本地开发、PM2、多数生产都用这个。
#   systemd LoadCredential（生产推荐，仅高敏项）
#     — 进程启动时覆盖 .env 同名变量；见 src/loadCredentials.ts
#     — 文件名 → 环境变量：
#         go_wallet_app_key              → GO_WALLET_APP_KEY
#         go_wallet_app_token            → GO_WALLET_APP_TOKEN
#         node_wallet_derivation_encryption_key → NODE_WALLET_DERIVATION_ENCRYPTION_KEY
#         custody_treasury_address       → CUSTODY_TREASURY_ADDRESS
#         cos_secret_id / cos_secret_key → COS_SECRET_ID / COS_SECRET_KEY
#     — 安装：sudo GO_WALLET_APP_KEY=... GO_WALLET_APP_TOKEN=... \
#             bash deploy/systemd/install-go-wallet-credentials.sh
#             详见 deploy/systemd/README.md
#
# 未列出的调参（SMART_MONEY_*、COPY_DISPATCH_*、REDEEM_* 间隔等）代码里已有默认值，
# 需要覆盖时再写进 .env；见 src/config/env.ts。
# =============================================================================

# ---------- 1) 启动必填（NODE_ENV=production 时缺一即退出）----------
# NODE_ENV=production
DATABASE_URL=
PORT=
JWT_SECRET=
API_KEY=
CUSTODY_ENCRYPT_KEY=
# Polygon 主读 RPC（未设会 warn；生产强烈建议填）
RPC_URL=
CHAIN_ID=
# 国库仅收款地址（0x+40hex）；生产可用 systemd credential custody_treasury_address
CUSTODY_TREASURY_ADDRESS=

# ---------- 2) 密钥 / 凭证（生产：下列可走 credential，其余写 .env）----------
# Polymarket API 凭证加密（32 字节 hex 或 base64）
SECRET_KEY=
# 内部服务共享密钥（须与 polymarket-admin-api / Go copy 一致）
COPY_INTERNAL_SECRET=
# Go wallet-api（派生 + 远程签名）。生产勿把 APP_KEY/TOKEN 写进 .env，用 credential
GO_WALLET_SERVICE_URL=
# 分机部署可写内网字面量，例如 http://172.19.0.5:9528（仅 RFC1918，勿用公网 IP）
# GO_WALLET_APP_KEY=
# GO_WALLET_APP_TOKEN=
# NODE_WALLET_DERIVATION_ENCRYPTION_KEY=
# 国库收款/佣金打款地址：须与 Go wallet security.treasury_address（mnemonicWithdraw 派生）一致，并持有 USDC.e + POL
# CUSTODY_TREASURY_ADDRESS=0x...
# Builder + Relayer（deposit 开通/交易/提现）
# POLYMARKET_BUILDER_API_KEY=
# POLYMARKET_BUILDER_SECRET=
# POLYMARKET_BUILDER_PASSPHRASE=
# POLYMARKET_BUILDER_BACKUP_CREDENTIALS=[{"label":"backup-1","key":"...","secret":"...","passphrase":"..."}]
# EOA→deposit 代付 POL（明文仅本地；生产用 v2: 密文）
# EOA_FORWARD_RELAYER_PRIVATE_KEY=
# EOA_FORWARD_RELAYER_PASSWORD=
# 邮箱：二选一
EMAIL_PROVIDER=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# EMAIL_PROVIDER=resend 时改用：
# RESEND_API_KEY=re_xxxxxxxx
# COS 密码表备份（可选；SECRET 可走 credential）
# WALLET_PASSWORD_COS_BACKUP_ENABLED=true
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=na-siliconvalley
# Admin TOTP 加密（仅 seedAdmin / 管理后台 2FA）
# TOTP_SECRET_ENCRYPTION_KEY=

# ---------- 3) 基础设施（按部署填）----------
NATS_URL=
COPY_ROBOT_CONTROL_NATS_ENABLED=
# RPC_FALLBACK_URLS=https://polygon-mainnet.g.alchemy.com/v2/your-key
# TRUST_PROXY=1
# 生产必填；未配置时生产拒绝跨域，非生产仅允许 localhost/127.0.0.1
# CORS_ALLOWED_ORIGINS=https://www.example.com
# 平台钱包交易路由默认关闭；需要时显式开启
# ENABLE_PLATFORM_TRADE_ROUTES=true
# CLOB 用户链路详细日志（默认关闭，排障后务必关掉）
# POLY_CLOB_DEBUG_USER_TRACE=false
# Passkey（生产按域名填）
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=CopyOdds
# PASSKEY_ORIGINS=https://your-app.example.com

# ---------- 4) 业务开关（有默认，一般不用改）----------
# AUTO_FORWARD_EOA_DEPOSIT=true
# AUTO_FUND_POLYMARKET_DEPOSIT=false
# AUTO_WRAP_POLYMARKET_DEPOSIT_USDCE=true
# POLYMARKET_BRIDGE_DEPOSIT_ENABLED=true
# GO_EOA_DEPOSIT_CALLBACK_ENABLED=true
# GO_FUNDER_DEPOSIT_CALLBACK_ENABLED=true
# REDEEM_CRON_ENABLED=true
# REDEEM_SWEEP_BATCH_SIZE=100
# REDEEM_SWEEP_USER_CONCURRENCY=5
# LEADERBOARD_CRON_ENABLED=true
# SMART_MONEY_CRON_ENABLED=true
# 独立 smart-money-worker 时，API 进程设为 false 避免双跑
# SMART_MONEY_CRONS_IN_API=false

# 独立虚拟账户模拟跟单（模拟执行只写 Virtual* 表；生产默认全关，按灰度开启）
# VIRTUAL_COPY_ACCOUNTS_ENABLED=false
# VIRTUAL_COPY_EXECUTION_ENABLED=false
# VIRTUAL_COPY_ORDERBOOK_FILL_ENABLED=false
# VIRTUAL_COPY_BUY_ENABLED=false
# VIRTUAL_COPY_SETTLEMENT_ENABLED=false
# VIRTUAL_COPY_ACTIVE_ACCOUNT_QUOTA=20
# VIRTUAL_COPY_ACTIVE_SUBSCRIPTION_QUOTA=200
# VIRTUAL_COPY_FANOUT_LIMIT=1000
# VIRTUAL_COPY_EXECUTION_INTERVAL_MS=5000
# VIRTUAL_COPY_LIFECYCLE_INTERVAL_MS=300000

COPY_MIN_FUNDING_USDC=
COPY_PNL_DAY_TIMEZONE=
COPY_PNL_DAY_RESET_HOUR=
ADMIN_DASHBOARD_CRON_ENABLED=
ADMIN_SESSION_COOKIE_NAME=
BACKEND_VERSION=

# Share / OG（Smart Money 外部分享页 + 预览图）
# PUBLIC_API_BASE_URL=https://api.copyodds.io
# PUBLIC_APP_BASE_URL=https://app.copyodds.io
# 用户实际分享的链接前缀（默认 API 根域名，生成 https://api.copyodds.io/@0x…）
# PUBLIC_OG_SHARE_BASE_URL=https://api.copyodds.io
# POLYMARKET_ANALYTICS_API_KEY=
# COPY_LISTENER_WATCH_ADDRESSES=
