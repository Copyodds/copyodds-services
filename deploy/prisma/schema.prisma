/// 跟单执行行（状态机）；表名 copy_trades
model CopyTradeRow {
  id             String           @id @default(uuid())
  userId         Int
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaderTradeId  String
  leaderTrade    LeaderTrade      @relation(fields: [leaderTradeId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   CopySubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Leader 原始订单 hash/标识（用于后台查询与去重诊断）
  leaderOrderHash String?
  chain           String     @default("POLYGON")
  marketId        String?
  marketTitle     String?
  side            TradeSide?
  tokenId         String?
  outcome         String?

  /// 金额/价格字段统一以字符串存储/返回，避免浮点
  orderAmount  String?
  filledAmount String?
  avgPrice     String?

  gasUsed             String?
  txHash              String?
  status              CopyTradeStatus @default(queued)
  errorMsg            String?
  errorCode           String?
  retryCount          Int             @default(0)
  polymarketOrderId   String?
  intendedPrice       String?
  intendedSize        String?
  intendedNotional    String?
  minNotionalAdjusted Boolean         @default(false)

  submittedAt DateTime?
  filledAt    DateTime?
  cancelledAt DateTime?

  /// 单笔跟单已实现盈亏（USD）；由结算/对账任务写入，未实现前为 null
  realizedPnlUsd Decimal?  @db.Decimal(38, 18)
  /// 盈亏归属时间（首次写入 realizedPnlUsd 时设置）；用于「今日收益」等按日聚合
  realizedPnlAt  DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  riskEvents RiskEvent[]

  @@unique([leaderTradeId, subscriptionId])
  @@index([userId, status])
  @@index([userId, status, createdAt])
  @@index([userId, subscriptionId, status, createdAt])
  @@index([userId, createdAt])
  @@index([subscriptionId, status, updatedAt])
  @@index([userId, status, updatedAt])
  @@index([userId, tokenId, createdAt])
  @@index([userId, realizedPnlAt])
  @@index([status, createdAt])
  @@map("copy_trades")
}

