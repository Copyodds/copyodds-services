// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id      Int    @id @default(autoincrement())
  address String @unique
  userId  Int?
  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Go wallet-api 业务序号（v3 不参与密码学路径；GO_REMOTE 必填）
  walletIndex       Int?
  /// v2_hd | v3_refer_pass
  derivationScheme  String  @default("v3_refer_pass")
  /// v2 迁移前的旧托管地址（归档）
  supersededAddress String?
  /// 托管签名：仅支持 GO_REMOTE（Go wallet-api + 远程签名）
  signingProvider   String  @default("GO_REMOTE")

  // 钱包类型：普通用户自托管地址 / 平台托管子钱包
  type String @default("USER_EOA")

  custodialKeys UserCustodialKey[]

  /// 该钱包在 Polymarket CLOB 上的 API 凭证（与托管私钥一一对应）
  apiCredential ApiCredential?

  /// Polymarket CLOB `funder` / maker：signature type 3（POLY_1271 / deposit wallet）时为官方 deposit 合约地址；也可用于 1/2 时与签名地址不同的 proxy/Safe
  polymarketFunderAddress           String?
  /// Deposit wallet SELL 授权准备的持久化缓存；命中时可跳过 relayer 注册/链上 allowance 扫描。
  polymarketSellPrepReadyAt         DateTime?
  polymarketSellPrepDeposit         String?
  /// Polymarket Relayer WALLET-CREATE 提交成功后的 transactionID（submit 后立即写入；wait 失败/超时时仍保留）。
  polymarketWalletCreateRelayerTxId String?

  createdAt DateTime @default(now())

  custodyChainDeposits CustodyChainDeposit[]
}

/// 链上 USDC 转入托管地址的记录（扫块写入；不自动增加站内 UserAsset）
model CustodyChainDeposit {
  id          String   @id @default(cuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    Int
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  txHash      String
  logIndex    Int
  fromAddress String
  toAddress   String
  amountRaw   String
  blockNumber BigInt
  confirmedAt DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([userId, confirmedAt])
  @@index([toAddress, confirmedAt])
}

/// 扫块游标（单例 id = polygon_usdc）
model CustodyDepositScanCursor {
  id        String   @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

enum CustodyWithdrawStatus {
  PENDING
  BROADCASTED
  FAILED
}

/// EOA 充值后自动归集至 Polymarket funder 的任务状态
enum CustodyEoaForwardStatus {
  PENDING
  IN_PROGRESS
  PENDING_GAS
  COMPLETED
  FAILED
}

/// EOA 入账后 custodial → funder 自动划转任务（运营补给 MATIC 后由 retry cron 重试）
model CustodyEoaForwardJob {
  id              String                  @id @default(cuid())
  userId          Int
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          CustodyEoaForwardStatus @default(PENDING)
  triggerTxHash   String?
  triggerLogIndex Int?
  idempotencyKey  String
  lastError       String?
  attempts        Int                     @default(0)
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([status, updatedAt])
  @@index([userId, createdAt])
}

/// Polymarket deposit（USDC.e）经 Relayer 提现至用户指定地址；与 CustodyWithdrawRequest 分离。
enum PolymarketDepositWithdrawStatus {
  PENDING
  RELAYER_SUBMITTED
  CONFIRMED
  FAILED
}

model PolymarketDepositWithdrawRequest {
  id                   String                          @id @default(cuid())
  userId               Int
  user                 User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey       String
  depositAddress       String
  toAddress            String
  amountRaw            String
  amount               Decimal                         @db.Decimal(38, 18)
  status               PolymarketDepositWithdrawStatus @default(PENDING)
  relayerTransactionId String?
  chainTxHash          String?
  error                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, createdAt])
}

/// 链上提现请求（幂等 + 可恢复）。同一 userId + idempotencyKey 只会广播一次。
model CustodyWithdrawRequest {
  id     String @id @default(cuid())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 客户端传入或服务端生成的幂等键（建议前端重试复用）
  idempotencyKey String

  fromAddress String
  toAddress   String
  amountRaw   String
  amount      Decimal @db.Decimal(38, 18)

  status CustodyWithdrawStatus @default(PENDING)
  txHash String?
  error  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([txHash])
}

/// 用户钱包统一流水（append-only；与 BillingLedger 并存，偏用户端展示）
model UserWalletLedger {
  id             String   @id @default(cuid())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredAt     DateTime @default(now())
  /// ONCHAIN_USDC | INTERNAL_USDC_E | GAS_POINTS
  rail           String
  /// CREDIT | DEBIT | LOCK | UNLOCK
  direction      String
  amount         Decimal  @db.Decimal(38, 18)
  symbol         String   @default("USDC.e")
  category       String
  refType        String?
  refId          String?
  idempotencyKey String?  @unique
  balanceAfter   Decimal? @db.Decimal(38, 18)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId, occurredAt])
  @@index([userId, category])
}

model User {
  id                    Int       @id @default(autoincrement())
  username              String    @unique
  email                 String?   @unique
  emailVerified         Boolean   @default(false)
  firstName             String?
  lastName              String?
  termsAcceptedAt       DateTime?
  tradingDisabled       Boolean   @default(false)
  tradingDisabledReason String?
  tradingDisabledUntil  DateTime?

  /// NORMAL | FROZEN | REVIEW
  tradeStatus       String    @default("NORMAL")
  frozenReason      String?
  frozenRemark      String?
  frozenAt          DateTime?
  frozenUntil       DateTime?
  frozenByAdminId   String?
  unfrozenAt        DateTime?
  unfrozenByAdminId String?
  unfrozenRemark    String?
  riskReviewReason  String?
  riskUpdatedAt     DateTime?

  userRiskLogs UserRiskLog[]

  // 钱包关联
  wallets                           Wallet[]
  walletDerivationCredential        WalletDerivationCredential?
  custodyWithdrawRequests           CustodyWithdrawRequest[]
  custodyEoaForwardJobs             CustodyEoaForwardJob[]
  polymarketDepositWithdrawRequests PolymarketDepositWithdrawRequest[]
  dailyActivities                   UserDailyActivity[]

  // 推广关系（树形）
  inviteCode                  String    @unique
  /// 旧版钱包密码，仅供一次性迁移；新签名链路不得读取。
  encryptedWalletPassword     String?
  /// v3 迁移状态: PENDING | COMPLETED
  walletDeriveMigrationStatus String    @default("PENDING")
  referrerId                  Int?
  referrer                    User?     @relation("UserReferrer", fields: [referrerId], references: [id])
  referrals                   User[]    @relation("UserReferrer")
  referralPath                String?
  referrerBoundAt             DateTime?
  referrerBindSource          String?
  referrerLockedAt            DateTime?

  // 推广档位（合伙人等级），1~5 表示不同分成比例，null 或 0 表示普通用户
  affiliateTier Int?
  affiliateNote String?

  // 平台 Gas 余额
  gasBalance Decimal @default(0) @db.Decimal(38, 18)

  // Gas 相关记录
  gasOrders                GasOrder[]
  gasBalanceLogs           GasBalanceLog[]
  shareToXGasClaims        ShareToXGasClaim[]
  commissionsFrom          GasCommission[]        @relation("CommissionFromUser")
  commissionsTo            GasCommission[]        @relation("CommissionToUser")
  mallCommissionAccount    MallCommissionAccount?
  mallCommissionEntries    MallCommissionLedger[]
  mallOrderCommissionsFrom MallOrderCommission[]  @relation("MallOrderCommissionFromUser")
  mallOrderCommissionsTo   MallOrderCommission[]  @relation("MallOrderCommissionToUser")
  referralBindingAudits    ReferralBindingAudit[] @relation("ReferralBindingUser")
  referralReceivedAudits   ReferralBindingAudit[] @relation("ReferralBindingReferrer")

  // 商店套餐订单
  gasPackageOrders    GasPackageOrder[]
  affiliateTierOrders AffiliateTierOrder[]

  // 托管相关
  custodialKeys UserCustodialKey[]
  assets        UserAsset[]
  balanceCache  UserBalanceCache?

  // Polymarket CLOB API 凭证（按 USER_EOA 钱包；secret/passphrase 加密存储）
  apiCredentials ApiCredential[]

  polymarketRedeemLogs          PolymarketRedeemLog[]
  polymarketRedeemAttemptStates PolymarketRedeemAttemptState[]
  positionScanState             UserPositionScanState?

  sessions           UserSession[]
  settings           UserSettings?
  passkeyCredentials PasskeyCredential[]

  // Authenticator TOTP (withdraw step-up only; secrets encrypted at rest)
  totpSecretEncrypted        String?
  totpEnabledAt              DateTime?
  totpPendingSecretEncrypted String?
  totpPendingCreatedAt       DateTime?

  copySubscriptions        CopySubscription[]
  copyTradeRows            CopyTradeRow[]
  copyPnlEvents            UserCopyPnlEvent[]
  copyPnlDailyRows         UserCopyPnlDaily[]
  virtualCopyAccounts      VirtualCopyAccount[]
  virtualCopySubscriptions VirtualCopySubscription[]
  virtualCopyExecutions    VirtualCopyExecution[]
  virtualPositionLots      VirtualPositionLot[]
  virtualPositionLotCloses VirtualPositionLotClose[]
  virtualAccountLedgers    VirtualAccountLedger[]
  virtualCloseQuotes       VirtualPositionCloseQuote[]
  auditEvents              AuditEvent[]
  riskEvents               RiskEvent[]
  billingLedgerEntries     BillingLedger[]
  userWalletLedgerEntries  UserWalletLedger[]

  custodyChainDeposits CustodyChainDeposit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId])
}

/// 按 invite/referCode 存储的明文 wallet_password（Node 签名时回传给 Go）。
/// cipher 列存明文密码；version>=2 表示明文存储（旧版 aes-256-gcm.* 需迁移脚本回写）。
model WalletDerivationCredential {
  referCode String   @id
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  cipher    String
  version   Int      @default(1)
  scheme    String   @default("v3_refer_pass")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PasskeyCredential {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId   String    @unique @db.VarChar(256)
  publicKey      Bytes
  algorithm      Int
  aaguid         String?   @db.VarChar(36)
  label          String?   @db.VarChar(128)
  signCount      Int       @default(0) @map("sign_count")
  backupEligible Boolean   @default(false)
  backupState    Boolean   @default(false)
  cloneWarning   Boolean   @default(false)
  transports     String?   @db.VarChar(128)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  requestId String   @id @db.VarChar(64)
  userId    Int
  kind      Int
  challenge String   @db.VarChar(128)
  expiresAt DateTime

  @@unique([userId, kind])
  @@map("passkey_challenges")
}

model UserSettings {
  userId Int  @id
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayPnlInUsd Boolean @default(true)
  showDemoData    Boolean @default(true)

  securityNoticeSeenAt DateTime?

  /// pnl-summary 持久化缓存，避免 40 万+ copy_trades 每次 SUM 聚合
  copyPnlTotalUsd      Decimal?  @db.Decimal(38, 18)
  copyPnlTodayUsd      Decimal?  @db.Decimal(38, 18)
  copyPnlWindowStartAt DateTime?
  copyPnlComputedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id                         String          @id @default(uuid())
  email                      String          @unique
  passwordHash               String
  name                       String?
  status                     AdminUserStatus @default(ACTIVE)
  /// SUPER_ADMIN | ADMIN
  role                       String          @default("SUPER_ADMIN")
  /// e.g. user.manage
  permissions                String[]        @default([])
  lastLoginAt                DateTime?
  totpSecretEncrypted        String?
  totpEnabledAt              DateTime?
  totpPendingSecretEncrypted String?
  totpPendingCreatedAt       DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  sessions         AdminSession[]
  actionLogs       AdminActionLog[]
  systemControls   SystemControl[]
  leaderRiskStates LeaderRiskState[]
}

enum TradingSystemMode {
  NORMAL
  TRACK_ONLY
  PAUSED
}

enum LeaderRiskStatus {
  ACTIVE
  WATCHLIST
  DISABLED
}

enum TraderStatus {
  ACTIVE
  DISABLED
  REVIEW
}

enum TraderSource {
  MANUAL
  SYSTEM
  IMPORT
}

model Trader {
  id               String       @id @default(uuid())
  name             String
  label            String?
  avatarUrl        String?
  description      String?
  status           TraderStatus @default(ACTIVE)
  source           TraderSource @default(MANUAL)
  createdByAdminId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  leaders CopyLeader[] @relation("TraderLeaders")

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@map("traders")
}

enum LeaderStatus {
  ACTIVE
  DISABLED
  REVIEW
}

enum LeaderSource {
  MANUAL
  SYSTEM
  IMPORT
}

enum LeaderRiskLevel {
  LOW
  MEDIUM
  HIGH
}

/// 跟单池中的 leader 地址（与链上监听过滤一致）
model CopyLeader {
  id          String          @id @default(uuid())
  address     String          @unique
  /// 链名称（目前默认 POLYGON）
  chain       String          @default("POLYGON")
  /// 后台展示用标签
  label       String?
  /// ACTIVE/DISABLED/REVIEW（与 enabled 并存，enabled 用于现有引擎开关）
  status      LeaderStatus    @default(ACTIVE)
  /// MANUAL/SYSTEM/IMPORT
  source      LeaderSource    @default(SYSTEM)
  /// LOW/MEDIUM/HIGH
  riskLevel   LeaderRiskLevel @default(LOW)
  lastTradeAt DateTime?

  traderId String?
  trader   Trader? @relation("TraderLeaders", fields: [traderId], references: [id], onDelete: SetNull)

  createdByAdminId String?
  enabled          Boolean  @default(true)
  tags             String[] @default([])
  /// Phase 2：最近一次聪明钱评分快照
  smartMoneyScore  Decimal? @db.Decimal(20, 8)
  copyabilityScore Decimal? @db.Decimal(20, 8)
  /// Smart Money 展示名快照（跟单列表读路径，避免联表）
  displayName      String?
  /// Smart Money X 用户名快照（无 @）
  xUsername        String?
  /// 产品档位快照 S|A|B|C|D
  tier             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions        CopySubscription[]
  virtualSubscriptions VirtualCopySubscription[]
  leaderTrades         LeaderTrade[]
  riskState            LeaderRiskState?
  riskEvents           RiskEvent[]

  @@index([traderId, createdAt])
  @@index([status, createdAt])
  @@index([source, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

/// 用户对某 leader 的订阅参数（合并原 CopyRelation + FollowStrategy 能力）
model CopySubscription {
  id       String     @id @default(uuid())
  userId   Int
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaderId String
  leader   CopyLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)

  /// ACTIVE/PAUSED/EXPIRED/CANCELLED（后台管理用；enabled 仍作为运行时权威开关）
  status SubscriptionStatus @default(ACTIVE)

  ruleName                   String?
  note                       String?
  copyMode                   CopyMode @default(RATIO)
  copyRatio                  Decimal  @default(1) @db.Decimal(10, 6)
  fixedAmountUsd             Decimal? @db.Decimal(38, 18)
  minNotionalMode            String   @default("BUMP_TO_MIN")
  minAmountUsd               Decimal? @db.Decimal(38, 18)
  maxAmount                  Decimal? @db.Decimal(38, 18)
  maxAmountPerMarketUsd      Decimal? @db.Decimal(38, 18)
  dailyTotalCapUsd           Decimal? @db.Decimal(38, 18)
  slippage                   Decimal? @db.Decimal(10, 6)
  delayMs                    Int      @default(0)
  marketCooldownMinutes      Int?
  pauseAfterConsecutiveFails Int?
  /// 同一订阅同一 outcome 已有未平仓跟单仓位时，跳过后续 BUY（防加仓耗尽资金；新手友好默认开）
  skipBuyIfOpenPosition      Boolean  @default(true)
  onlyBuy                    Boolean  @default(false)
  onlySell                   Boolean  @default(false)
  enabled                    Boolean  @default(true)

  /// 最大 Gas 限制（后台管理配置）
  maxGas      Decimal?  @db.Decimal(38, 18)
  /// 生命周期时间戳（后台展示/筛选）
  startedAt   DateTime?
  expiredAt   DateTime?
  pausedAt    DateTime?
  cancelledAt DateTime?

  /// 连续失败计数（Postgres 风控，替代 Redis fail streak）
  failStreakCount      Int       @default(0)
  failStreakUpdatedAt  DateTime?
  pausedUntil          DateTime?
  pauseReason          String?
  /// 资金不足自动暂停元数据（enabled=false 为权威状态）
  fundingPausedAt      DateTime?
  fundingPausedCode    String?
  fundingPausedReason  String?
  /// 资金不足但仍保留监听（例如仍有可卖持仓）
  fundingWarningAt     DateTime?
  fundingWarningCode   String?
  fundingWarningReason String?
  deletedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copyTrades      CopyTradeRow[]
  riskEvents      RiskEvent[]
  marketCooldowns CopyMarketCooldown[]

  @@unique([userId, leaderId])
  @@index([leaderId])
  @@index([userId, fundingPausedAt])
  @@index([userId, fundingPausedCode])
  @@index([userId, fundingWarningCode])
  @@index([userId, deletedAt])
}

/// 链上 OrderFilled 落库（幂等：leaderAddress + tx_hash + log_index）
model LeaderTrade {
  id              String   @id @default(uuid())
  leaderAddress   String
  txHash          String
  logIndex        Int
  sourceFillCount Int      @default(1)
  signalSource    String   @default("order_filled")
  side            String
  amount          String
  price           String
  marketId        String?
  marketTitle     String?
  tokenId         String
  outcome         String?
  maker           String
  taker           String
  makerAssetId    String   @default("")
  takerAssetId    String   @default("")
  blockNumber     Int?
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  leaderId String?
  leader   CopyLeader? @relation(fields: [leaderId], references: [id], onDelete: SetNull)

  copyTrades        CopyTradeRow[]
  virtualExecutions VirtualCopyExecution[]
  riskEvents        RiskEvent[]

  @@unique([leaderAddress, txHash, logIndex])
  @@index([leaderAddress])
  @@index([leaderAddress, txHash])
  @@index([tokenId])
  @@index([createdAt])
  // Replay/archive sweeps filter on processed + createdAt; without this the
  // sweep seq-scans the whole table and holds a pool connection for 20s+.
  @@index([processed, createdAt])
}

enum CopyTradeStatus {
  queued
  risk_pending
  skipped
  submitting
  submitted
  filled
  failed
  dead
}

enum CopyMode {
  RATIO
  FIXED_AMOUNT
  SMART
}

enum TradeSide {
  BUY
  SELL
}

enum VirtualAccountStatus {
  ACTIVE
  PAUSED
  EXPIRED_CLOSING
  SETTLED
  ARCHIVED
}

enum VirtualExecutionStatus {
  QUEUED
  SIMULATING
  FILLED
  PARTIALLY_FILLED
  SKIPPED
  FAILED
  DEAD
  SETTLED
}

model VirtualCopyAccount {
  id                 String               @id @default(uuid())
  userId             Int
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  currency           String               @default("USD")
  initialBalanceUsd  Decimal              @db.Decimal(38, 18)
  cashBalanceUsd     Decimal              @db.Decimal(38, 18)
  reservedBalanceUsd Decimal              @default(0) @db.Decimal(38, 18)
  realizedPnlUsd     Decimal              @default(0) @db.Decimal(38, 18)
  status             VirtualAccountStatus @default(ACTIVE)
  startedAt          DateTime             @default(now())
  expiresAt          DateTime
  expiredAt          DateTime?
  settledAt          DateTime?
  archivedAt         DateTime?
  version            Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  subscriptions   VirtualCopySubscription[]
  executions      VirtualCopyExecution[]
  lots            VirtualPositionLot[]
  lotCloses       VirtualPositionLotClose[]
  ledgerEntries   VirtualAccountLedger[]
  equitySnapshots VirtualAccountEquitySnapshot[]
  closeQuotes     VirtualPositionCloseQuote[]

  @@unique([userId, name])
  @@index([userId, status, createdAt])
  @@index([status, expiresAt])
}

model VirtualCopySubscription {
  id                         String             @id @default(uuid())
  accountId                  String
  account                    VirtualCopyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId                     Int
  user                       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaderId                   String
  leader                     CopyLeader         @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  ruleName                   String?
  note                       String?
  copyMode                   CopyMode           @default(RATIO)
  copyRatio                  Decimal            @default(1) @db.Decimal(10, 6)
  fixedAmountUsd             Decimal?           @db.Decimal(38, 18)
  minNotionalMode            String             @default("BUMP_TO_MIN")
  minAmountUsd               Decimal?           @db.Decimal(38, 18)
  maxAmountUsd               Decimal?           @db.Decimal(38, 18)
  maxAmountPerMarketUsd      Decimal?           @db.Decimal(38, 18)
  dailyTotalCapUsd           Decimal?           @db.Decimal(38, 18)
  maxSlippage                Decimal?           @db.Decimal(10, 6)
  delayMs                    Int                @default(0)
  marketCooldownMinutes      Int?
  pauseAfterConsecutiveFails Int?
  /// 同一订阅同一 outcome 已有未平仓虚拟仓位时，跳过后续 BUY
  skipBuyIfOpenPosition      Boolean            @default(true)
  onlyBuy                    Boolean            @default(false)
  onlySell                   Boolean            @default(false)
  enabled                    Boolean            @default(true)
  status                     SubscriptionStatus @default(ACTIVE)
  startedAt                  DateTime           @default(now())
  pausedAt                   DateTime?
  expiredAt                  DateTime?
  deletedAt                  DateTime?
  failStreakCount            Int                @default(0)
  failStreakUpdatedAt        DateTime?
  pausedUntil                DateTime?
  pauseReason                String?
