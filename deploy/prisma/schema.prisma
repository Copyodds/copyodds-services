/// Share to X 每日 GAS 奖励领取记录（按 userId + UTC 日唯一）
model ShareToXGasClaim {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet    String?
  gasAmount Decimal  @db.Decimal(38, 18)
  claimDate DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, claimDate])
  @@index([userId, createdAt])
}

model ReferralBindingAudit {
  id                   Int       @id @default(autoincrement())
  userId               Int?
  user                 User?     @relation("ReferralBindingUser", fields: [userId], references: [id], onDelete: SetNull)
  referrerId           Int?
  referrer             User?     @relation("ReferralBindingReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  targetEmail          String?
  inviteCodeRaw        String?
  inviteCodeNormalized String?
  bindSource           String
  bindStatus           String
  failureReason        String?
  referralPathSnapshot String?
  boundAt              DateTime?
  createdAt            DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([referrerId, createdAt])
  @@index([inviteCodeNormalized])
  @@index([bindStatus, createdAt])
}

model GasPackage {
  id                 Int      @id @default(autoincrement())
  name               String?
  usdPrice           Decimal  @db.Decimal(38, 18)
  originalUsdPrice   Decimal? @db.Decimal(38, 18)
  bonusAffiliateTier Int?
  gasAmount          Decimal  @db.Decimal(38, 18)
  description        String?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  chainId            Int?
  currency           String?  @default("USD")

  orders    GasPackageOrder[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model GasPackageOrder {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  packageId Int
  package   GasPackage @relation(fields: [packageId], references: [id])

  status                     String
  txHash                     String?
  paymentConfirmedAt         DateTime?
  fulfilledAt                DateTime?
  commissionSettlementStatus String    @default("PENDING")
  commissionSettledAt        DateTime?

  paidUsd   Decimal @db.Decimal(38, 18)
  gasAmount Decimal @db.Decimal(38, 18)

  bonusAffiliateTierGranted   Int?
  bonusAffiliateTierGrantedAt DateTime?

  // 可选：关联一条 GasOrder 记录，表示本次套餐购买在主 Gas 订单表中的记录
  gasOrderId           Int?
  mallOrderCommissions MallOrderCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// settings：最近已履约套餐 orderBy fulfilledAt DESC
  @@index([userId, fulfilledAt(sort: Desc)])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AffiliateTierProduct {
  id               Int      @id @default(autoincrement())
  name             String?
  affiliateTier    Int
  usdPrice         Decimal  @db.Decimal(38, 18)
  originalUsdPrice Decimal? @db.Decimal(38, 18)
  description      String?
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  orders    AffiliateTierOrder[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([isActive, sortOrder])
  @@index([affiliateTier])
}

model AffiliateTierOrder {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  productId Int
  product   AffiliateTierProduct @relation(fields: [productId], references: [id])

  status                     String
  txHash                     String?
  paymentConfirmedAt         DateTime?
  fulfilledAt                DateTime?
  commissionSettlementStatus String    @default("PENDING")
  commissionSettledAt        DateTime?

  paidUsd       Decimal  @db.Decimal(38, 18)
  listUsdPrice  Decimal? @db.Decimal(38, 18)
  creditUsd     Decimal? @db.Decimal(38, 18)
  affiliateTier Int

  mallOrderCommissions MallOrderCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([productId])
  @@index([status, createdAt])
}

model MallCommissionAccount {
  userId           Int      @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0) @db.Decimal(38, 18)
  totalEarned      Decimal  @default(0) @db.Decimal(38, 18)
  totalSettled     Decimal  @default(0) @db.Decimal(38, 18)
  totalReversed    Decimal  @default(0) @db.Decimal(38, 18)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ledgerEntries MallCommissionLedger[]
}

model MallCommissionLedger {
  id                  Int                   @id @default(autoincrement())
  accountUserId       Int
  account             MallCommissionAccount @relation(fields: [accountUserId], references: [userId], onDelete: Cascade)
  userId              Int
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  change              Decimal               @db.Decimal(38, 18)
  balanceAfter        Decimal               @db.Decimal(38, 18)
  entryType           String
  sourceType          String
  sourceOrderId       String
  ruleVersion         String?
  relatedCommissionId Int?
  note                String?
  createdAt           DateTime              @default(now())

  @@index([accountUserId, createdAt])
  @@index([userId, createdAt])
  @@index([sourceType, sourceOrderId])
}

model MallOrderCommission {
  id                   Int                 @id @default(autoincrement())
  orderId              Int?
  order                GasPackageOrder?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  affiliateTierOrderId Int?
  affiliateTierOrder   AffiliateTierOrder? @relation(fields: [affiliateTierOrderId], references: [id], onDelete: Cascade)
  fromUserId           Int
  fromUser             User                @relation("MallOrderCommissionFromUser", fields: [fromUserId], references: [id])
  toUserId             Int
  toUser               User                @relation("MallOrderCommissionToUser", fields: [toUserId], references: [id])
  level                Int
  commissionAmount     Decimal             @db.Decimal(38, 18)
  settlementStatus     String
  sourceType           String              @default("MALL_ORDER")
  sourceOrderId        String
  ruleVersion          String              @default("affiliate_v1")
  tierAtTheTime        Int?
  rateAtTheTime        Decimal?            @db.Decimal(10, 6)
  settledAt            DateTime?
  reversedAt           DateTime?
  /// 用户领取入账时间；null 表示待领取
  claimedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([sourceType, sourceOrderId, toUserId, level])
  @@index([fromUserId, createdAt])
  @@index([affiliateTierOrderId])
  @@index([toUserId, createdAt])
  @@index([toUserId, claimedAt])
  @@index([sourceType, sourceOrderId])
  @@index([settlementStatus, createdAt])
}

/// 用户 Polymarket API Key（按钱包；apiSecret / passphrase 存 AES-GCM 密文）
model ApiCredential {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  walletId Int    @unique
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  apiKey     String
  apiSecret  String
  passphrase String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CopyRelation {
  id              String   @id @default(uuid())
  leaderAddress   String
  followerUserId  Int
  followerAddress String
  apiKeyEncrypted String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([leaderAddress, followerUserId])
}

/// 跟单执行记录（用于观测：是否检测到 leader 事件、是否为用户下单）
model CopyExecution {
  id String @id @default(uuid())

  followerUserId Int
  leaderAddress  String
  tokenID        String
  side           String
  price          Decimal @db.Decimal(38, 18)
  size           Decimal @db.Decimal(38, 18)

  ratioApplied Decimal? @db.Decimal(10, 6)
  notional     Decimal? @db.Decimal(38, 18)

  status            String
  polymarketOrderId String?
  error             String?

  createdAt DateTime @default(now())

  @@index([followerUserId, createdAt])
  @@index([followerUserId, status])
  @@index([followerUserId, tokenID, status])
  @@index([leaderAddress, createdAt])
}

/// CTF redeem 成功记录（按用户 + conditionId 幂等）
model PolymarketRedeemLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditionId String
  txHash      String
  createdAt   DateTime @default(now())

  @@unique([userId, conditionId])
  @@index([userId])
}

/// 自动赎回失败计数：同一持仓连续失败达到上限后不再自动兑换（手动赎回不受影响）
model PolymarketRedeemAttemptState {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conditionId  String
  outcomeIndex Int       @default(0)
  failCount    Int       @default(0)
  lastError    String?
  lastFailedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, conditionId, outcomeIndex])
  @@index([userId, failCount])
}

/// copy listener 的链上回放游标（按 listener key 持久化）
model CopyListenerCursor {
  key         String   @id
  blockNumber Int
  logIndex    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Polymarket Data API /v1/leaderboard 缓存（按完整批次切换，仅保留最新批次）
model LeaderboardRow {
  id           Int      @id @default(autoincrement())
  category     String
  timePeriod   String
  orderBy      String
  batchId      String
  syncVersion  Int      @default(0)
  rank         Int
  proxyWallet  String
  userName     String?
  profileImage String?
  xUsername    String?
  vol          Decimal  @db.Decimal(38, 18)
  pnl          Decimal  @db.Decimal(38, 18)
  syncedAt     DateTime

  @@unique([category, timePeriod, orderBy, batchId, rank])
  @@index([category, timePeriod, orderBy])
  @@index([category, timePeriod, orderBy, batchId])
  @@index([category, orderBy, batchId])
  @@index([batchId])
  @@index([proxyWallet])
}

/// 官方榜滑动窗口游标：每个 preset（category × timePeriod × orderBy）一行，
/// 记录下一轮要拉的 offset；扫到尾部后回 0 并递增 cycleId
model LeaderboardSyncCursor {
  id           Int       @id @default(autoincrement())
  category     String
  timePeriod   String
  orderBy      String
  nextOffset   Int       @default(0)
  cycleId      Int       @default(1)
  lastWindowAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([category, timePeriod, orderBy])
}

/// 轻量 cron 租约：用于多实例场景下抢占单任务执行权
model CronLease {
  key       String   @id
  owner     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// 用户持仓/赎回扫描状态：交易后标记 active，cron 只扫描到期 active 用户，避免全量扫钱包。
model UserPositionScanState {
  userId          Int       @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active          Boolean   @default(true)
  hasOpenPosition Boolean   @default(true)
  nextScanAt      DateTime  @default(now())
  lastScannedAt   DateTime?
  lastTradeAt     DateTime?
  lastRedeemedAt  DateTime?
  scanCount       Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, nextScanAt])
  @@index([hasOpenPosition, nextScanAt])
  @@index([lastTradeAt])
}

/// 外部排行榜指标缓存：保存第三方程序预先计算好的收益质量指标，按周期保留历史版本
model PredictingTopLeaderboardRow {
  id                 Int       @id @default(autoincrement())
  period             String
  syncVersion        Int       @default(0)
  rank               Int
  wallet             String
  name               String?
  twitter            String?
  profileImage       String?
  platform           String?
  polymarketProfile  String?
  walletCount        Int?
  pnl                Decimal?  @db.Decimal(38, 18)
  buys               Int?
  sells              Int?
  deposits           Decimal?  @db.Decimal(38, 18)
  withdrawals        Decimal?  @db.Decimal(38, 18)
  views              Int?
  smartScore         Decimal?  @db.Decimal(20, 8)
  tier               String?
  avgDailyReturn     Decimal?  @db.Decimal(20, 8)
  bestDay            Decimal?  @db.Decimal(20, 8)
  worstDay           Decimal?  @db.Decimal(20, 8)
  winRate            Decimal?  @db.Decimal(20, 8)
  profitFactor       Decimal?  @db.Decimal(20, 8)
  rSquared           Decimal?  @db.Decimal(20, 8)
  sharpeRatio        Decimal?  @db.Decimal(20, 8)
  sortinoRatio       Decimal?  @db.Decimal(20, 8)
  calmarRatio        Decimal?  @db.Decimal(20, 8)
  maxDrawdown        Decimal?  @db.Decimal(38, 18)
  maxDrawdownPercent Decimal?  @db.Decimal(20, 8)
  currentDrawdown    Decimal?  @db.Decimal(20, 8)
  totalReturn        Decimal?  @db.Decimal(38, 18)
  trendSlope         Decimal?  @db.Decimal(38, 18)
  calculatedAt       DateTime?
  rawPayload         Json?
  syncedAt           DateTime

  @@index([period, rank])
  @@index([period, syncVersion])
  @@index([wallet])
}

/// Polymarket Analytics (Falcon / Heisenberg) 排行榜缓存
model PolymarketAnalyticsLeaderboardRow {
  id            Int      @id @default(autoincrement())
  period        String
  syncVersion   Int      @default(0)
  rank          Int
  wallet        String
  hScore        Decimal? @db.Decimal(20, 8)
  roi           Decimal? @db.Decimal(20, 8)
  winRate       Decimal? @db.Decimal(20, 8)
  sharpeRatio   Decimal? @db.Decimal(20, 8)
  totalPnl      Decimal? @db.Decimal(38, 18)
  totalVolume   Decimal? @db.Decimal(38, 18)
  totalTrades   Int?
  marketsTraded Int?
  tier          String?
  rawPayload    Json?
  syncedAt      DateTime

  @@index([period, rank])
  @@index([period, syncVersion])
  @@index([wallet])
}

/// 聪明钱候选池：由外部榜并集同步而来，承载抓取/黑名单/调度状态
model ObservedTrader {
  id                      Int       @id @default(autoincrement())
  wallet                  String    @unique
  profileSlug             String?
  sourceRankWeek          Int?
  sourceRankMonth         Int?
  sourceRankAll           Int?
  officialSourceRankWeek  Int?
  officialSourceRankMonth Int?
  officialSourceRankAll   Int?
  externalSourceRankWeek  Int?
  externalSourceRankMonth Int?
  externalSourceRankAll   Int?
  candidatePeriods        String[]  @default([])
  candidateCategories     String[]  @default(["OVERALL"])
  candidateActive         Boolean   @default(true)
  candidateOrigin         String    @default("LEADERBOARD") // LEADERBOARD | BLOCK_SCAN | MANUAL
  candidateSourceVersion  Int       @default(0)
  candidateLastSeenAt     DateTime
  enabled                 Boolean   @default(true)
  blacklisted             Boolean   @default(false)
  noiseTags               String[]  @default([])
  lastSeenAt              DateTime
  lastFetchedAt           DateTime?
  lastScoredAt            DateTime?
  fetchFailCount          Int       @default(0)
  lastFetchError          String?
  lastFetchStatus         String?
  nextRetryAt             DateTime?
  /// Phase 0+ pipeline 预备字段（Phase 1 启用）
  pipelineStage           String    @default("LEGACY")
  sources                 String[]  @default([])
  nextLightAnalyzeAt      DateTime?
  nextDeepAnalyzeAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([enabled, blacklisted])
  @@index([candidateActive, enabled, blacklisted])
  @@index([candidateOrigin, candidateActive])
  @@index([candidateSourceVersion])
  @@index([candidateLastSeenAt])
  @@index([lastFetchedAt])
  @@index([lastSeenAt])
  @@index([nextRetryAt])
}

/// 扫块发现的链上活跃地址：经门槛过滤后晋升 ObservedTrader 参与聪明钱评分
model BlockScanDiscoveredTrader {
  wallet            String    @id
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  lastBlockNumber   Int
  fillCount         Int       @default(0)
  windowStartBlock  Int
  windowFillCount   Int       @default(0)
  maxSingleNotional Decimal   @default(0) @db.Decimal(38, 18)
  qualifiedAt       DateTime?
  promotedAt        DateTime?
  scoredAt          DateTime?
  /// ACCUMULATING 累计中 | PROMOTED 已晋升待评分 | SCORED 已评分
  status            String    @default("ACCUMULATING")
  lastIngestAt      DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([qualifiedAt])
  @@index([promotedAt, qualifiedAt])
  @@index([status])
  @@index([lastSeenAt])
}

/// 用户主页摘要快照：保留每次抓到的核心画像，便于后续调参与回溯
model TraderProfileSnapshot {
  id              Int      @id @default(autoincrement())
  wallet          String
  profileSlug     String?
  displayName     String?
  joinedAtText    String?
  viewsText       String?
  holdingsValue   Decimal? @db.Decimal(38, 18)
  biggestWin      Decimal? @db.Decimal(38, 18)
  predictionCount Int?
  rawSummary      Json?
  sourceUrl       String?
  snapshotAt      DateTime
  createdAt       DateTime @default(now())

  @@index([wallet, snapshotAt])
  @@index([profileSlug])
}

/// 收益/价值曲线点：按某次快照批量写入，用于平滑度和近期强度计算
model TraderCurvePoint {
  id         Int      @id @default(autoincrement())
  wallet     String
  curveType  String
  ts         DateTime
  value      Decimal  @db.Decimal(38, 18)
  snapshotAt DateTime
  createdAt  DateTime @default(now())

  @@index([wallet, curveType, snapshotAt])
  @@index([wallet, ts])
}

/// Closed-positions 预热快照：Gate/Full 与 Deep 解耦；断点续拉
model SmartMoneyClosedSnapshot {
  id             Int       @id @default(autoincrement())
  wallet         String
  /// GATE | FULL
  purpose        String
  windowDays     Int       @default(365)
  /// PENDING | FETCHING | READY | FAILED
  status         String    @default("PENDING")
  /// DataApiPosition[] JSON
  rowsJson       Json?
  rowCount       Int       @default(0)
  pageCount      Int       @default(0)
  /// 下一页页码（0-based），断点续拉
  nextPage       Int       @default(0)
  /// 目标最多页（GATE≈30 / FULL≈80）
  targetMaxPages Int       @default(30)
  capped         Boolean   @default(false)
  timedOut       Boolean   @default(false)
  windowComplete Boolean   @default(false)
  fetchOk        Boolean   @default(false)
  lastError      String?
  /// 存量中最新一条可解析平仓时间（增量 checkpoint）
  newestClosedAt DateTime?
  /// 存量中最旧一条可解析平仓时间
  oldestClosedAt DateTime?
  /// 全量重建代数
  incrementalEpoch Int      @default(0)
  /// 上次增量成功时间
  lastIncrementalAt DateTime?
  fetchedAt      DateTime?
  readyAt        DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([wallet, purpose, windowDays])
  @@index([status, updatedAt])
  @@index([purpose, status, expiresAt])
  @@index([wallet, purpose, status])
}

/// Tier 阈值 Admin 快照（singleton id=1；覆盖 env 默认值）
model SmartMoneyTierConfig {
  id        Int      @id @default(1)
  config    Json
  updatedAt DateTime @updatedAt
}

/// 聪明钱榜最终缓存行：保留当前每个地址的最新评分与可展示字段
model SmartMoneyLeaderboardRow {
  id                      Int       @id @default(autoincrement())
  wallet                  String    @unique
  rank                    Int?
  score                   Decimal   @db.Decimal(20, 8)
  pnlQuality              Decimal   @db.Decimal(20, 8)
  activityScore           Decimal   @db.Decimal(20, 8)
  consistencyScore        Decimal   @db.Decimal(20, 8)
  officialCandidateScore  Decimal   @default(0) @db.Decimal(20, 8)
  externalQualityScore    Decimal   @default(0) @db.Decimal(20, 8)
  riskPenalty             Decimal   @db.Decimal(20, 8)
  eligible                Boolean   @default(true)
  riskFlags               String[]  @default([])
  scoreVersion            String
  sourceFetchedAt         DateTime?
  lastScoredAt            DateTime
  syncedAt                DateTime
  displayName             String?
  profileSlug             String?
  joinedAtText            String?
  profileImage            String?
  xUsername               String?
  predictionCount         Int?
  holdingsValue           Decimal?  @db.Decimal(38, 18)
  /// 用于榜单排序与筛选：评分时写入 resolved total PnL
  totalPnl                Decimal?  @db.Decimal(38, 18)
  sourceRankWeek          Int?
  sourceRankMonth         Int?
  sourceRankAll           Int?
  officialSourceRankWeek  Int?
  officialSourceRankMonth Int?
  officialSourceRankAll   Int?
  externalSourceRankWeek  Int?
  externalSourceRankMonth Int?
  externalSourceRankAll   Int?
  candidatePeriods        String[]  @default([])
  candidateCategories     String[]  @default(["OVERALL"])
  /// 是否在活跃候选池（与 ObservedTrader 同步，避免 cached API 大 IN 查询）
  activeCandidate         Boolean   @default(false)
  /// predicting.top 外部指标：优先 ALL，其次 30D、7D 单条记录上的胜率 / 夏普 / 总回报
  externalWinRate         Decimal?  @db.Decimal(38, 18)
  externalSharpeRatio     Decimal?  @db.Decimal(38, 18)
  externalTotalReturn     Decimal?  @db.Decimal(38, 18)
  /// 权威回撤（比率 0~1）：评分时写入，L1 与列表共用
  maxDrawdownPercent      Decimal?  @db.Decimal(20, 8)
  externalMetricsPeriod   String?
  /// 当前外部展示/评分指标来源：PREDICTING_TOP / LOCAL_FALLBACK / MIXED
  externalMetricsSource   String?
  /// 胜率展示来源：MARKET_CLOSED | PREDICTING_TOP | CURVE_PROXY
  winRateSource           String?
  /// 外部指标来源 badge：PREDICTING_TOP | LOCAL_FALLBACK | MIXED
  metricsSourceBadge      String?
  scoreExplain            Json?
  /// Phase 1：是否在跟单榜 CopyPool 内
  inCopyPool              Boolean   @default(false)
  copyPoolEnteredAt       DateTime?
  copyPoolExitedAt        DateTime?
  copyPoolMissCount       Int       @default(0)
  /// Phase 2：30d 跟单仿真分 0–100
  copyabilityScore        Decimal?  @db.Decimal(20, 8)
  /// Phase 2：榜内排序分（copyability×w + smartMoney×w）
  displayScore            Decimal?  @db.Decimal(20, 8)
  copyabilityComputedAt   DateTime?
  /// Phase 3：ML 排序分 0–100（跟单反馈 + v3.1 特征）
  rankScore               Decimal?  @db.Decimal(20, 8)
  rankScoreComputedAt     DateTime?
  /// Phase 3：跟单者 30d ROI 聚合快照（JSON）
  copierFeedback          Json?
  /// 设计 §3/§4.5：近 7 日盈利（1W 曲线）
  recentPnl7d             Decimal?  @db.Decimal(38, 18)
  /// 近 30 日盈利（ALL 曲线截窗）
  recentPnl30d            Decimal?  @db.Decimal(38, 18)
  /// 近 7 日成交笔数
  trades7d                Int?
  /// 近 30 日成交笔数
  trades30d               Int?
  /// 1Y 截窗总盈利（不足一年则为生涯窗）
  totalPnl1y              Decimal?  @db.Decimal(38, 18)
  /// 总盈利实际窗口天数
  pnlWindowDays           Int?
  /// 与 1Y PnL 同窗、同本金的收益率
  totalReturn1y           Decimal?  @db.Decimal(20, 8)
  /// 与 1Y PnL 同窗、同本金的最大回撤
  maxDrawdown1y           Decimal?  @db.Decimal(20, 8)
  /// 仿真回测盈亏 USD
  backtestPnlUsd          Decimal?  @db.Decimal(38, 18)
  /// 仿真损失率
  copyLossRate            Decimal?  @db.Decimal(20, 8)
  /// 仿真有效滑点 bps
  slippageBpsEffective    Int?
  /// Deep-Enrich：1D/1M 曲线补全时间；null 表示待补
  lastCurveEnrichAt       DateTime?
  /// 入榜后待补全窗 trades / copyability 仿真
  enrichPending           Boolean   @default(false)
  /// P0–P2：TraderScore 0–100（主展示/排序可切换）
  traderScore             Decimal?  @db.Decimal(20, 8)
  /// 产品档位 S|A|B|C|D
  tier                    String?
  /// 预测能力 Edge 分 0–100
  edgeScore               Decimal?  @db.Decimal(20, 8)
  /// Edge 已结算独立市场样本数
  edgeSampleN             Int?
  /// INFORMATION|ARBITRAGE|GAMBLER|MARKET_MAKER|GENERAL
  traderType              String?
  /// 活跃/存活天数
  activeDays              Int?
  /// 最大单市场盈利 USD
  maxWinTradeUsd          Decimal?  @db.Decimal(38, 18)
  /// 最大单市场亏损 USD（负值）
  maxLossTradeUsd         Decimal?  @db.Decimal(38, 18)

  @@index([eligible, score(sort: Desc)])
  @@index([activeCandidate, eligible, sourceFetchedAt, rank])
  @@index([inCopyPool, rank])
  @@index([inCopyPool, displayScore(sort: Desc)])
  @@index([inCopyPool, traderScore(sort: Desc)])
  @@index([inCopyPool, tier])
  @@index([eligible, totalPnl(sort: Desc)])
  @@index([rank])
  @@index([syncedAt])
  @@index([lastCurveEnrichAt])
  @@index([inCopyPool, enrichPending])
}

/// 聪明钱管道：统一地址 registry（去重 + 调度）
model SmartMoneyRawAddress {
  wallet                String    @id
  sources               String[]  @default([])
  firstSeenAt           DateTime
  lastSeenAt            DateTime
  /// 最近一次尝试 ingest 进 RAW 的时间（冷却去重）
  lastIngestedAt        DateTime?
  lastLightQueuedAt     DateTime?
  lastDeepQueuedAt      DateTime?
  nextLightAnalyzeAt    DateTime?
  nextDeepAnalyzeAt     DateTime?
  lightAnalyzeCursor    BigInt    @default(0)
  deepAnalyzeCursor     BigInt    @default(0)
  /// RAW | LIGHT_ANALYZING | QUALIFIED | FULL_ANALYZING | SCORED | COPY_POOL | BLOCKED | DORMANT | ELIMINATED
  pipelineStage         String    @default("RAW")
  tier1lPassedAt        DateTime?
  tier1fPassedAt        DateTime?
  tier2CorePassedAt     DateTime?
  tier2EnhancedPassedAt DateTime?
  tierFailReason        String?
  dormant               Boolean   @default(false)
  /// 淘汰池连续复检失败次数
  elimFailCount         Int       @default(0)
  /// 淘汰池冻结截止（连续失败达上限后）
  elimFrozenUntil       DateTime?
  /// 淘汰池下次慢检时间
  nextElimCheckAt       DateTime?
  /// HOT | COLD | PURGED（仅 ELIMINATED 有意义；默认 HOT）
  elimBucket            String    @default("HOT")
  /// 最近成交迹象（扫块/trades）；供冷清除
  lastTradeAt           DateTime?
  /// SCORED 连续未入 CopyPool 次数（Phase G：达上限则淘汰）
  scoredMissCount       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([pipelineStage, nextLightAnalyzeAt])
  @@index([pipelineStage, nextDeepAnalyzeAt])
  @@index([pipelineStage, nextElimCheckAt])
  @@index([pipelineStage, scoredMissCount])
  @@index([pipelineStage, elimBucket, nextElimCheckAt])
  @@index([lightAnalyzeCursor])
  @@index([deepAnalyzeCursor])
  @@index([lastIngestedAt])
}

/// 发现源游标（官方长尾 / 第三方 / 扫块）
model SmartMoneyDiscoveryCursor {
  source      String   @id
  cursor      String   @default("0")
  syncVersion Int?
  meta        Json?
  updatedAt   DateTime @updatedAt
}

model SmartMoneyPipelineCursor {
  id                     Int       @id @default(1)
  lightRoundRobinCounter BigInt    @default(0)
  deepRoundRobinCounter  BigInt    @default(0)
  lastLightTickAt        DateTime?
  lastDeepTickAt         DateTime?
  updatedAt              DateTime  @updatedAt
}

/// 内部 Scored 缓存（未入 CopyPool 或历史分数）
model SmartMoneyScoreCache {
  wallet                String    @id
  score                 Decimal   @db.Decimal(20, 8)
  scoreVersion          String
  riskFlags             String[]  @default([])
  scoreExplain          Json?
  tier1fPassedAt        DateTime?
  tier2CorePassedAt     DateTime?
  tier2EnhancedPassedAt DateTime?
  lastScoredAt          DateTime
  updatedAt             DateTime  @updatedAt

  @@index([score(sort: Desc)])
  @@index([lastScoredAt])
}

/// 用户按需地址分析任务：短队列（总容量 5、并发 1），结果落 SmartMoneyScoreCache。
model SmartMoneyAnalyzeJob {
  id         String    @id @default(cuid())
  wallet     String
  userId     Int
  period     String    @default("ALL")
  /// PENDING | RUNNING | READY | FAILED | EXPIRED
  status     String    @default("PENDING")
  /// SKIP | ENRICH_ONLY | DEEP
  action     String    @default("DEEP")
  error      String?
  /// 活跃任务去重键；PENDING/RUNNING 时等于 wallet，结束后置空。
  activeKey  String?   @unique
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([wallet, createdAt(sort: Desc)])
}

/// 后台首页统计快照（定时刷新，避免首页实时大表 COUNT）
model AdminStatsSnapshot {
  id        String   @id @default(cuid())
  statKey   String   @map("stat_key")
  statValue String   @map("stat_value")
  statExtra Json?    @map("stat_extra")
  period    String   @default("current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([statKey, period])
  @@map("admin_stats_snapshot")
}

/// 后台首页「最近动态」
model AdminActivityLog {
  id         String   @id @default(cuid())
  eventType  String   @map("event_type")
  title      String
  content    String?
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id")
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  level      String   @default("info")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([eventType])
  @@map("admin_activity_logs")
}

/// 后台系统告警
model AdminAlert {
  id         String    @id @default(cuid())
  alertType  String    @map("alert_type")
  title      String
  content    String?
  level      String    @default("warning")
  status     String    @default("open")
  source     String?
  targetId   String?   @map("target_id")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("admin_alerts")
}

/// 后台首页「表现领先地址」
model LeaderPerformanceStat {
  id             String   @id @default(cuid())
  leaderAddress  String   @map("leader_address")
  roi            Decimal  @db.Decimal(20, 8)
  winRate        Decimal  @map("win_rate") @db.Decimal(20, 8)
  followersCount Int      @default(0) @map("followers_count")
  copyVolume     Decimal? @map("copy_volume") @db.Decimal(38, 18)
  profitUsdt     Decimal? @map("profit_usdt") @db.Decimal(38, 18)
  riskLevel      String   @default("medium") @map("risk_level")
  period         String   @default("30d")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([leaderAddress, period])
  @@index([period, roi(sort: Desc)])
  @@map("leader_performance_stats")
}

/// 系统运行状态（节点、同步、版本等）
model SystemRuntimeStatus {
  id          String   @id @default(cuid())
  statusKey   String   @unique @map("status_key")
  statusValue String   @map("status_value")
  statusExtra Json?    @map("status_extra")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_runtime_status")
}

/// 每日运营统计（趋势图）
model AdminDailyStat {
  id                    String   @id @default(cuid())
  statDate              DateTime @unique @map("stat_date") @db.Date
  registeredUsers       Int      @default(0) @map("registered_users")
  newRegisteredUsers    Int      @default(0) @map("new_registered_users")
  walletBoundUsers      Int      @default(0) @map("wallet_bound_users")
  activeCopyTraders     Int      @default(0) @map("active_copy_traders")
  copySuccessCount      Int      @default(0) @map("copy_success_count")
  copyFailedCount       Int      @default(0) @map("copy_failed_count")
  riskBlockCount        Int      @default(0) @map("risk_block_count")
  gasOrderCount         Int      @default(0) @map("gas_order_count")
  onlineUsers           Int      @default(0) @map("online_users")
  subscribedAddresses   Int      @default(0) @map("subscribed_addresses")
  gasPurchaseCount      Int      @default(0) @map("gas_purchase_count")
  gasPurchaseAmountUsdt Decimal  @default(0) @map("gas_purchase_amount_usdt") @db.Decimal(30, 8)
  commissionUsdt        Decimal  @default(0) @map("commission_usdt") @db.Decimal(38, 18)
  observedTradersTotal  Int      @default(0) @map("observed_traders_total")
  uptimePercent         Decimal  @default(0) @map("uptime_percent") @db.Decimal(10, 4)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("admin_daily_stats")
}

/// 用户日活跃（DAU）落表，用于在线人数趋势（onlineUsers = DAU）
model UserDailyActivity {
  id            String   @id @default(cuid())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityDate  DateTime @map("activity_date") @db.Date
  lastActiveAt  DateTime @map("last_active_at")
  activityCount Int      @default(0) @map("activity_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, activityDate])
  @@index([activityDate])
  @@map("user_daily_activity")
}

/// 统一分佣流水（后台分佣管理）
model CommissionRecord {
  id                String    @id
  referrerUserId    Int
  invitedUserId     Int
  inviteCode        String?
  sourceType        String
  sourceOrderId     String
  sourceOrderAmount Decimal   @db.Decimal(38, 18)
  commissionRate    Decimal?  @db.Decimal(10, 6)
  commissionAmount  Decimal   @db.Decimal(38, 18)
  currency          String    @default("USDC")
  level             Int       @default(1)
  status            String    @default("PENDING")
  settledAt         DateTime?
  paidAt            DateTime?
  canceledAt        DateTime?
  remark            String?
  legacyKind        String?
  legacyId          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  adminLogs CommissionAdminLog[]

  @@unique([sourceType, sourceOrderId, referrerUserId, level])
  @@index([referrerUserId])
  @@index([invitedUserId])
  @@index([sourceOrderId])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
  @@index([inviteCode])
}

model CommissionRule {
  id                    String   @id @default("default")
  enabled               Boolean  @default(true)
  levelOneRate          Decimal  @db.Decimal(10, 6)
  levelTwoEnabled       Boolean  @default(false)
  levelTwoRate          Decimal  @db.Decimal(10, 6)
  packageCommissionRate Decimal  @db.Decimal(10, 6)
  gasCommissionRate     Decimal  @db.Decimal(10, 6)
  minSettlementAmount   Decimal  @db.Decimal(38, 18)
  settlementCycle       String   @default("DAILY")
  currency              String   @default("USDC")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CommissionRiskAlert {
  id              String    @id
  level           String
  type            String
  title           String
  description     String
  relatedRecordId String?
  relatedOrderId  String?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}

model CommissionAdminLog {
  id         String           @id
  recordId   String
  record     CommissionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  adminId    String
  action     String
  beforeData Json?
  afterData  Json?
  remark     String?
  createdAt  DateTime         @default(now())

  @@index([recordId])
  @@index([createdAt])
}
